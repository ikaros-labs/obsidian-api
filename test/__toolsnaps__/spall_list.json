{
  "name": "spall_list",
  "title": "List a folder",
  "description": "Lists a folder: notes, files and folders (view=entries), only folders as an indented tree with note counts (view=tree), or tags with counts (view=tags). where/missing filter notes by frontmatter. Folders marked traverse_only are shown only on the way to folders you can read.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "folder": {
        "default": "",
        "description": "Folder relative to your root; \"\" is the root",
        "type": "string"
      },
      "view": {
        "default": "entries",
        "type": "string",
        "enum": [
          "entries",
          "tree",
          "tags"
        ]
      },
      "depth": {
        "default": "1",
        "description": "\"all\" lists the whole subtree",
        "type": "string",
        "enum": [
          "1",
          "all"
        ]
      },
      "max_depth": {
        "default": 3,
        "description": "view=tree: folder levels to show",
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      },
      "where": {
        "description": "Frontmatter conditions, ANDed: \"Status=Done\", \"Score>=4\", \"Due<2026-12-01\"; = matches list items",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "missing": {
        "description": "Notes without these properties",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "sort": {
        "default": "name",
        "type": "string",
        "enum": [
          "name",
          "-modified",
          "modified",
          "-created",
          "created",
          "-name"
        ]
      },
      "limit": {
        "default": 200,
        "description": "Entries per page (view=tree: folders shown)",
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      },
      "cursor": {
        "description": "next_cursor from the previous page",
        "type": "string"
      },
      "frontmatter": {
        "default": false,
        "description": "Include each note's frontmatter",
        "type": "boolean"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "annotations": {
    "title": "List a folder",
    "readOnlyHint": true,
    "openWorldHint": false
  }
}
