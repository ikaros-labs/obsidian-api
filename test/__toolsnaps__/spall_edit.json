{
  "name": "spall_edit",
  "title": "Edit a note",
  "description": "Edits a note in place; all ops apply atomically or none do. Ops: append/prepend/replace (whole body, a heading's section or a block), replace_text (exact match), frontmatter.set/unset/merge (keeps value types), replace_all (whole file; must be the only op). Pass expected_rev (from spall_read) so you never overwrite a change you haven't seen.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "Note path relative to your root; \".md\" optional"
      },
      "expected_rev": {
        "description": "rev from spall_read; the edit fails if the note changed",
        "type": "string"
      },
      "ops": {
        "minItems": 1,
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "append",
                "prepend",
                "replace",
                "replace_text",
                "frontmatter.set",
                "frontmatter.unset",
                "frontmatter.merge",
                "replace_all"
              ]
            },
            "heading": {
              "description": "Target section, e.g. \"Notes > Highlights\"",
              "type": "string"
            },
            "index": {
              "description": "Which match when the heading is ambiguous",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "block": {
              "description": "Target block id (without ^)",
              "type": "string"
            },
            "content": {
              "description": "append/prepend/replace/replace_all text",
              "type": "string"
            },
            "key": {
              "description": "frontmatter.set/unset key",
              "type": "string"
            },
            "value": {
              "description": "frontmatter.set value, or frontmatter.merge object"
            },
            "old": {
              "description": "replace_text: exact text to find",
              "type": "string"
            },
            "new": {
              "description": "replace_text: replacement",
              "type": "string"
            },
            "count": {
              "description": "replace_text: max occurrences (default 1)",
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "op"
          ]
        }
      }
    },
    "required": [
      "path",
      "ops"
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  },
  "annotations": {
    "title": "Edit a note",
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false
  }
}
